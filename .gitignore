# Standard Unity .gitignore file
# Covers Unity generated directories, build outputs, temp files, and IDE configuration.

# Unity generated directories
/[aA]rchives/
/[lL]ibrary/
/[lL]ogs/
/[uU]ser[sS]ettings/
/[tT]emp/
/[oO]bj/
/[bB]uild/
/[bB]uilds/
/[lL]ocal[cC]ache/
/[mM]emoryCaptures/
/[rR]ecordings/
/Assets/Screenshots/

# Unity scratch / temp
.utmp/

# Local tooling state (NuGet fallback packages, machine-specific)
.local/

# Memory Dumps
*.lmp

# Crash Reports
sysinfo.txt

# Auto-generated Solution and Project files
/*.csproj
/*.unityproj
/*.sln
/*.suo
/*.tmp
/*.user
/*.userprefs
/*.pidb
/*.booproj
/*.svd
/*.pdb
/*.mdb
/*.opendb
/*.VC.db
/*.cache

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE and Editor files
.vs/
.idea/
.vscode/
.gemini/
*.csproj.user

# Builds & Packages
*.apk
*.aab
*.unitypackage
*.app
*.ipa

# Android & Gradle
.gradle/
build/
captures/

# Xcode Project
/[xX]code[pP]roject/

# Firebase (issue #31)
# Service-account credentials must NEVER enter the repository; the seeder
# reads them from GOOGLE_APPLICATION_CREDENTIALS instead.
*service-account*.json
*ServiceAccount*.json
google-services.json
firebase/tests/node_modules/
firebase-debug.log
firestore-debug.log
firebase.json.local

# Python tooling cache (scripts/ imports validate-content.py)
__pycache__/

service-account.json
